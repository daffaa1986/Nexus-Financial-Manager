# Nexus Finance AI - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# 1. AI SERVICE: Google Gemini
# ============================================
# Required for: AI categorization, OCR receipts, AI insights
# Get API key at: https://aistudio.google.com/
GEMINI_API_KEY=MASUKKAN_API_KEY_YANG_VALID_DISINI

# ============================================
# 2. BACKEND SERVER (Python FastAPI)
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# 3. DATABASE (Default: SQLite)
# ============================================
# Options: sqlite, mysql, postgresql
DB_TYPE=sqlite

# MySQL Configuration (if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nexus_finance
MYSQL_USER=root
MYSQL_PASSWORD=

# PostgreSQL Configuration (if DB_TYPE=postgresql)
PGHOST=localhost
PGPORT=5432
PGDATABASE=nexus_finance
PGUSER=postgres
PGPASSWORD=
